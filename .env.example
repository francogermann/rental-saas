# -----------------------------------------------------------------------------
# Panel /admin — credenciales solo en el servidor (nunca NEXT_PUBLIC_*)
# Generá un secreto largo, por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# -----------------------------------------------------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
# Rol del usuario del panel: administrator | manager | seller (por defecto administrator si vacío)
ADMIN_ROLE=manager
