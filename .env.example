# -----------------------------------------------------------------------------
# Panel /admin — una sola cuenta (acceso completo al tablero)
# Credenciales solo en el servidor (nunca NEXT_PUBLIC_*).
# Generá un secreto largo, por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# -----------------------------------------------------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
# Recomendado en producción: administrator (todos los permisos del panel).
# Valores manager | seller siguen soportados por compatibilidad / pruebas locales.
ADMIN_ROLE=administrator

# -----------------------------------------------------------------------------
# Catálogo / Supabase Auth (cliente)
# En Supabase Dashboard → Authentication → Providers → Email:
# desactivar "Confirm email" para que el registro web entre al dashboard sin verificación.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (emails de lista de espera)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Checkout / Mercado Pago
# development: mock | production: mercadopago (default si hay MP_ACCESS_TOKEN)
# En dev sin token, se usa mock automáticamente.
# -----------------------------------------------------------------------------
CHECKOUT_PAYMENT_MODE=mock
MP_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Lista de espera — Resend + disparo manual / externo (sin Vercel Cron de pago)
# -----------------------------------------------------------------------------
# Opcional: mismo endpoint que usa el panel; curl o cron-job.org con header:
#   Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
