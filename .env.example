# -----------------------------------------------------------------------------
# Panel /admin — credenciales solo en el servidor (nunca NEXT_PUBLIC_*)
# Generá un secreto largo, por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# -----------------------------------------------------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
# Rol del usuario del panel: administrator | manager | seller (por defecto administrator si vacío)
ADMIN_ROLE=manager

# -----------------------------------------------------------------------------
# Catálogo / Supabase Auth (cliente)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (emails de lista de espera)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Lista de espera — Resend + disparo manual / externo (sin Vercel Cron de pago)
# -----------------------------------------------------------------------------
# Opcional: mismo endpoint que usa el panel; curl o cron-job.org con header:
#   Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
